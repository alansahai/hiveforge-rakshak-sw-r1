# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Storage Directories
DATA_DIR=./data
MODELS_DIR=./models

# Authentication & Security
# DEMO_MODE=true: Bypasses mandatory Bearer token auth for seamless local evaluations
# DEMO_MODE=false: Enforces valid Bearer JWT tokens on all dashboard and alert endpoints
DEMO_MODE=true
SECRET_KEY=mplads-sih2026-secret-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Email & Alert Dispatcher (Optional SMTP)
ENABLE_SMTP=false
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=mplad-alerts@mospi.gov.in
SENDER_PASSWORD=your-app-password-here
