# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# CORS Configuration (Required for Railway + Vercel deployment)
# Comma-separated allowed frontend origins, or '*' for open access.
# Note: Any domain matching https://*.vercel.app is automatically accepted.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-vercel-domain.vercel.app

# Storage Directories
DATA_DIR=./data
MODELS_DIR=./models

# Authentication & Security
# DEMO_MODE: Set 'true' for local judge/reviewer demos (bypasses mandatory login for seamless evaluation).
#            Set 'false' for public/shared deployment (strictly enforces Bearer JWT tokens on all dashboard and alert endpoints).
DEMO_MODE=true
SECRET_KEY=mplads-sih2026-secret-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Email & Alert Dispatcher (Optional SMTP)
ENABLE_SMTP=false
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=mplad-alerts@mospi.gov.in
SENDER_PASSWORD=your-app-password-here
